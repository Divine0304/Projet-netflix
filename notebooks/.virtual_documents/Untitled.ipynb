# Étape 6 : Liste des films récupérés manuellement sur IMDb
films_manuels = [
    {"title": "Scary Stories to Tell in the Dark", "description": "Un groupe d'adolescents doivent affronter leurs peurs afin de survivre.", "release_year": 2019, "difficulty": "Évident/culte"},
    {"title": "Wednesday", "description": "Mercredi Addams tente de maîtriser ses capacités psychiques et de résoudre le mystère qui a impliqué ses parents.", "release_year": 2022, "difficulty": "Évident/culte"},
    {"title": "Frankenstein", "description": "Victor Frankenstein donne vie à une créature lors d'une expérience interdite.", "release_year": 2025, "difficulty": "Évident/culte"},
    {"title": "Troll", "description": "Une créature gigantesque se réveille après mille ans et détruit tout sur son passage vers Oslo.", "release_year": 2022, "difficulty": "Facile/accessible"},
    {"title": "Under Paris", "description": "Une scientifique doit faire face à son passé pour sauver Paris d'un requin géant dans la Seine.", "release_year": 2024, "difficulty": "Facile/accessible"},
    {"title": "Anaconda", "description": "Deux amis d'enfance voyagent au cœur de l'Amazonie pour tourner le remake de leur film préféré.", "release_year": 2025, "difficulty": "Facile/accessible"},
    {"title": "The Meg", "description": "Jonas Taylor doit surmonter ses peurs pour secourir des personnes prisonnières d'un requin de 23 mètres de long.", "release_year": 2018, "difficulty": "Facile/accessible"},
    {"title": "A Quiet Place", "description": "Une famille est forcée de vivre en silence pour se protéger de monstres à l'ouïe ultra-sensible.", "release_year": 2018, "difficulty": "Moyen/technique"},
    {"title": "Day Shift", "description": "Un père utilise son travail de nettoyage de piscine comme façade pour chasser et tuer des vampires.", "release_year": 2022, "difficulty": "Moyen/technique"},
    {"title": "No One Gets Out Alive", "description": "Une immigrante se retrouve prisonnière d'un cauchemar sans issue dans une pension.", "release_year": 2021, "difficulty": "Difficile/expert"},
    {"title": "Viking Wolf", "description": "Thale, 17 ans, vient d'emménager dans une petite ville après que sa mère a trouvé un nouveau boulot dans la police locale.", "release_year": 2022, "difficulty": "Difficile/expert"},
    {"title": "Sweet Home", "description": "Hyunsoo, un lycéen solitaire, emménage dans un ancien immeuble alors que des humains se transforment en monstres.", "release_year": 2020, "difficulty": "Difficile/expert"}
]

import pandas as pd
df_manuels = pd.DataFrame(films_manuels)
print(f"{len(df_manuels)} films ajoutés manuellement.")


# Fusion et calcul des points
resultat_final = pd.concat([df_final, df_manuels], ignore_index=True)

resultat_final['points'] = resultat_final['difficulty'].map({
    'Évident/culte': 5,
    'Facile/accessible': 10,
    'Moyen/technique': 20,
    'Difficile/expert': 30
})

print(f"Total de la liste : {len(resultat_final)} films.")


import json

#  : Génération du fichier data/films.js
json_data = resultat_final.to_dict(orient='records')
with open('../data/films.js', 'w', encoding='utf-8') as f:
    f.write(f"const filmsData = {json.dumps(json_data, ensure_ascii=False, indent=4)};")

print("Fichier data/films.js généré ! ")






